{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iloilo-incident-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "APP_ENV": "unconfigured",
    "ENABLE_DEV_REVIEW": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iloilo-incidents-local",
      // Deliberately invalid for real deployment: local development only.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
