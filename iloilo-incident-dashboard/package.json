{
  "name": "iloilo-incident-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "start:local": "npm run build && npm run dev:worker",
    "build": "npm run typecheck && vite build",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "preview": "vite preview --host 127.0.0.1",
    "db:check:local": "wrangler d1 execute DB --local --command 'SELECT 1 AS local_database_ready;'"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
